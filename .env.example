# Copy to .env.local and set your PostgreSQL connection string.
DATABASE_URL="postgresql://USER:PASSWORD@localhost:5432/qarjy?schema=public"

# Optional. Set to the public HTTPS origin when running behind a proxy.
# QARJY_ORIGIN="https://qarjy.example"

# Optional. Only needed to claim a previous shared JSON ledger.
# QARJY_LEGACY_PATH="data/finance.json"
# FINANCE_API_KEY=""
# Neon migrations: direct connection to the same branch and database.
# DIRECT_URL="postgresql://USER:PASSWORD@HOST/DB?sslmode=require"

# Neon CLI automatically pulls DATABASE_URL_UNPOOLED for Prisma migrations.
# DIRECT_URL, when explicitly set, takes precedence over DATABASE_URL_UNPOOLED.
